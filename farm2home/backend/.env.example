# Backend environment variables
# Copy this to .env and fill in your values

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=farm2home
DB_USER=postgres
DB_PASSWORD=yourpassword

# JWT
JWT_SECRET=farm2home_super_secret_key_change_in_prod
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# Admin seed (used by seed.js)
ADMIN_EMAIL=admin@farm2home.com
ADMIN_PASSWORD=Admin@1234

# AI Service URL
AI_SERVICE_URL=http://localhost:8000
