# ==============================================================================
# AUTONOMOUS VEHICLE SIMULATION ENVIRONMENT CONFIGURATION
# Project: Adaptive Path Planning and Collision Avoidance on Unstructured Indian Roads
# ==============================================================================

# CARLA Simulator Connection
CARLA_HOST=localhost
CARLA_PORT=2000
CARLA_TIMEOUT=10.0
CARLA_MAP=Town03
CARLA_SYNC_MODE=true
CARLA_DELTA_SECONDS=0.05
CARLA_RENDER_SPECTATOR=true

# Vehicle Dynamics
VEHICLE_BLUEPRINT=vehicle.tesla.model3
MAX_SPEED=40.0
MAX_ACCELERATION=3.0
MAX_BRAKING=6.0

# Sensor Suite
CAMERA_WIDTH=800
CAMERA_HEIGHT=600
CAMERA_FOV=90.0

# YOLO Perception
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE=0.45
PERCEPTION_DEVICE=cpu

# Planning & Safety
REPLAN_INTERVAL=0.1
OBSTACLE_CLEARANCE=1.8

# Time-To-Collision (TTC) Thresholds (in seconds)
TTC_WARNING_THRESHOLD=4.0
TTC_HIGH_THRESHOLD=2.5
TTC_CRITICAL_THRESHOLD=1.5

# High-Level Navigation (Optional)
GOOGLE_MAPS_API_KEY=
ENABLE_GOOGLE_MAPS=false
